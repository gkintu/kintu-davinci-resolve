						ShadowOffset = Input { Value = { 0.5141421356, 0.4858578644 }, Expression = "Point(0.5 + DropDistance * math.cos(math.rad(DropAngle)), 0.5 - DropDistance * math.sin(math.rad(DropAngle)))", },
						Softness = Input { Value = 0.0225, Expression = "PiPBlur * 0.05", },
						Red = Input { Value = 0, }, Green = Input { Value = 0, }, Blue = Input { Value = 0, }, Alpha = Input { Value = 0.65, Expression = "ShadowStrength", },
						OutputMode = Input { Value = 1, }, ClippingMode = Input { Value = FuID { "None" }, },
