						DropAngle = { LINKS_Name = "Angle", LINKID_DataType = "Number", INPID_InputControl = "ScrewControl", ICS_ControlPage = "Shadow", INP_Default = 45, INP_MinScale = 0, INP_MaxScale = 360, },
						DropDistance = { LINKS_Name = "Distance", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", ICS_ControlPage = "Shadow", INP_Default = 0.02, INP_MinScale = 0, INP_MaxScale = 0.1, },
						PiPBlur = { LINKS_Name = "Blur", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", ICS_ControlPage = "Shadow", INP_Default = 0.45, INP_MinScale = 0, INP_MaxScale = 1, },
