				ImageOpacity = InstanceInput { SourceOp = "ImageOverShadow", Source = "Blend", Name = "Opacity", Page = "Image", Default = 1, MinScale = 0, MaxScale = 1, },
				CornerRadius = InstanceInput { SourceOp = "RoundedAlphaErode", Source = "CornerRadius", Name = "Corner Radius", Page = "Rounded Corners", Default = 0.03, MinScale = 0, MaxScale = 0.5, },
