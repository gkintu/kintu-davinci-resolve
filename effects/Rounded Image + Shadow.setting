				ShadowGreen = InstanceInput { SourceOp = "AlphaShadow", Source = "Green", Page = "Shadow", ControlGroup = 10, Default = 0, },
				ShadowBlue = InstanceInput { SourceOp = "AlphaShadow", Source = "Blue", Page = "Shadow", ControlGroup = 10, Default = 0, },
				ShadowAngle = InstanceInput { SourceOp = "AlphaShadow", Source = "DropAngle", Name = "Angle", Page = "Shadow", Default = 45, MinScale = 0, MaxScale = 360, },
				ShadowDistance = InstanceInput { SourceOp = "AlphaShadow", Source = "DropDistance", Name = "Distance", Page = "Shadow", Default = 0.02, MinScale = 0, MaxScale = 0.1, },
				ShadowExpand = InstanceInput { SourceOp = "ShadowExpand", Source = "Size", Name = "Expand", Page = "Shadow", Default = 1, MinScale = 0.5, MaxScale = 1.5, },
				ShadowBlur = InstanceInput { SourceOp = "AlphaShadow", Source = "PiPBlur", Name = "Blur", Page = "Shadow", Default = 0.45, MinScale = 0, MaxScale = 1, },
				MainInput1 = InstanceInput { SourceOp = "SourceInput", Source = "Input", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "EffectBypass", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				SourceInput = Transform {
					CtrlWShown = false,
					Inputs = { Size = Input { Value = 1, }, Edges = Input { Value = 0, }, },
					ViewInfo = OperatorInfo { Pos = { -110, 0 } },
				},
				HQAlphaDivide = AlphaDivide {
    Inputs = { Input = Input { SourceOp = "ImageTransform", Source = "Output", }, },
},
HQPremultiply = AlphaMultiply {
    Inputs = { Input = Input { SourceOp = "RoundedAlphaRestore", Source = "Output", }, },
},
TransparentCanvas = Background {
					CtrlWShown = false,
					Inputs = { UseFrameFormatSettings = Input { Value = 1, }, Width = Input { Value = 1920, }, Height = Input { Value = 1080, }, TopLeftAlpha = Input { Value = 0, }, },
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				RoundedAlphaErode = ErodeDilate {
					Inputs = {
						Input = Input { SourceOp = "HQAlphaDivide", Source = "Output", },
						Filter = Input { Value = 3, }, LockXY = Input { Value = 1, },
						Red = Input { Value = 0, }, Green = Input { Value = 0, }, Blue = Input { Value = 0, }, Alpha = Input { Value = 1, },
						XAmount = Input { Value = -0.006, Expression = "-math.max(0, CornerRadius * 0.263 - 0.0019) * math.abs(ImageTransform.Size)", },
						ClippingMode = Input { Value = FuID { "None" }, },
					},
					UserControls = ordered() {
						CornerRadius = { LINKS_Name = "Corner Radius", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", ICS_ControlPage = "Rounded Corners", INP_Default = 0.03, INP_MinScale = 0, INP_MaxScale = 0.5, },
					},
					ViewInfo = OperatorInfo { Pos = { 0, 0 } },
				},
				RoundedAlphaRestore = ErodeDilate {
