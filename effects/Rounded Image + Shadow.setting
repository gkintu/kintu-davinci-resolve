						PositionY = { LINKS_Name = "Position Y", LINKID_DataType = "Number", INPID_InputControl = "SliderControl", ICS_ControlPage = "Image", INP_Default = 0.5, INP_MinScale = 0, INP_MaxScale = 1, },
