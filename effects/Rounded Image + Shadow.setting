{
	Tools = ordered() {
		RoundedImageShadow = GroupOperator {
			CtrlWZoom = false,
			Inputs = ordered() {
				EnableEffect = InstanceInput { SourceOp = "EffectBypass", Source = "EffectEnabled", Name = "Enable Effect", Page = "Image", Default = 1, },
